# Copy to .env.local (or set these in your host, e.g. Vercel).

# --- Supabase: a NEW project (Singapore region), see README -----------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: creates businesses and logins. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- You, the platform owner --------------------------------------------------
# Emails that can open /platform (approve payments, see every business).
PLATFORM_ADMIN_EMAILS=archtechbtg@gmail.com

# --- Plan and payments ----------------------------------------------------------
NEXT_PUBLIC_PRICE_MONTHLY=499
# Optional yearly price. Leave out to offer monthly only.
# NEXT_PUBLIC_PRICE_YEARLY=4990
# Where people can reach you, shown on the website.
NEXT_PUBLIC_CONTACT_EMAIL=archtechbtg@gmail.com
# Shown on the Billing page. Use \n for new lines.
PAYMENT_INSTRUCTIONS="GCash: 0917 000 0000 (Your Name)\nBank transfer: BDO 0000 0000 0000 (Your Name)\nThen send the reference number below."

# --- Email (optional, see README) ------------------------------------------------
# With these set: password reset links, email confirmation at sign-up, and
# notices (new sign-ups and payments to you; approvals and reminders to owners).
# RESEND_API_KEY=re_...
# EMAIL_FROM="Business Suite <no-reply@mail.yourdomain.com>"
# Your site's address for links in emails. On Vercel it's found automatically.
# SITE_URL=https://yourdomain.com
# Any long random text. Vercel uses it to run the daily reminders (vercel.json).
# CRON_SECRET=

# --- Look and feel --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Business Suite
NEXT_PUBLIC_ACCENT_COLOR=#4c7dff
NEXT_PUBLIC_CURRENCY=PHP
NEXT_PUBLIC_LOCALE=en-PH
NEXT_PUBLIC_TIMEZONE=Asia/Manila
# Leave empty for all modules: inventory, sales, attendance, fleet.
NEXT_PUBLIC_MODULES=

# Staff logins are stored as username@<business>.<this domain>. Set once, never change.
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=staff.local
